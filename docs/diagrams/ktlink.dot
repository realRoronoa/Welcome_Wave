digraph G {
  graph [rankdir=TB, fontname="Carlito", nodesep=0.3, ranksep=0.4, pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="white", color="#9aa6c2", fontname="Carlito", fontsize=12, fontcolor="#1d2742", margin="0.12,0.07"];
  edge [color="#55607a", arrowsize=0.7, fontname="Carlito", fontsize=10, fontcolor="#55607a"];
  rec [label="KT recording\n(GCS, speech +\nshared screen)", shape=cylinder, fillcolor="#edf0f5"];
  seg [label="Gemini, 10-min clips\n(video offsets)\nutterances, screen\nmoments, actions"];
  red [label="Redact\nemails, phones,\nkeys"];
  m1 [label="1  Path on screen\nsuffix match to repo\n0.85 to 0.97"];
  m2 [label="2  Symbol on screen\nfunction / class index\n0.60 to 0.88"];
  m3 [label="3  By meaning\nscreen text + nearby\nspeech, cap 0.75"];
  merge [label="Merge adjacent\nmoments into clips"];
  links [label="kt_links\nmeeting, time span,\nfile, lines, confidence", shape=cylinder, fillcolor="#e3f2f0", color="#0b7a75", penwidth=1.6];
  u1 [label="Code view\nplay-clip marks"]; u2 [label="Chat answers\ncite the clip"]; u3 [label="Coverage map\nmodules never explained"]; u4 [label="Task agent\nnext KT agenda,\ngap tasks"];
  rec -> seg; seg -> red [label="transcript"]; red -> store; seg -> m1 [label="screen moments"];
  store [label="transcript_segments\n+ searchable chunks", shape=cylinder]; m1 -> m2 [label="none found"]; m2 -> m3 [label="none found"];
  {rank=same; m1; m2; m3}
  {rank=same; u1; u2; u3; u4}
  m1 -> merge; m2 -> merge; m3 -> merge; merge -> links; links -> u1; links -> u2; links -> u3; links -> u4;
}
