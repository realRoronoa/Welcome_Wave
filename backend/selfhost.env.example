# Welcome Wave, self-hosted (MODE=self_hosted): the real application on one machine.
# ./scripts/selfhost.sh setup  copies this to backend/selfhost.env with fresh database passwords. Never commit selfhost.env.
MODE=self_hosted
ENV=dev                      # prod on a server people use: refuses development settings such as the Firebase emulator

# ---- database: Postgres + pgvector in Docker (container ww-db, port 5433, volume ww-db-data) ----
DB_OWNER_PASSWORD=change-me  # the owner role: runs migrations only
APP_DB_PASSWORD=change-me    # the app role ww_app: no row-level-security bypass
DATABASE_URL=postgresql+psycopg://ww_app:change-me@127.0.0.1:5433/welcomewave

# ---- sign-in: Firebase Authentication (free; no billing needed) ----
# console.firebase.google.com -> Add project -> Build: Authentication -> Get started -> enable Email/Password and Google.
# Project settings -> General -> "Web API key" and "Project ID". Authentication -> Settings -> Authorized domains: add yours.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=        # defaults to <project id>.firebaseapp.com
# Development only, before the Firebase project exists: the local Firebase Auth emulator (npx firebase-tools emulators:start
# --only auth --project demo-welcome-wave). Accounts made there are for testing; the server refuses this with ENV=prod.
# FIREBASE_PROJECT_ID=demo-welcome-wave
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---- AI: a Gemini API key (https://aistudio.google.com/apikey). Empty = the AI is off, and the app says so. ----
GEMINI_API_KEY=
# Generally available Gemini API models (the code's defaults). `python -m scripts.check_models` (in backend/) lists the
# models your key can use and calls each of these once. MODEL_FALLBACK is a chain: each model has its own free-tier quota.
MODEL_FAST=gemini-3.5-flash-lite
MODEL_SMART=gemini-3.5-flash
MODEL_FALLBACK=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash

# ---- repositories: connected by their GitHub URL, and polled (no webhook needed) ----
# GITHUB_ALLOWED_OWNERS: the GitHub users or organisations (comma-separated) whose PRIVATE repositories may be connected
# through GITHUB_TOKEN. Empty: only public repositories can be connected.
GITHUB_TOKEN=                # optional, read-only fine-grained token: private repositories, 5,000 API calls/hour instead of 60
GITHUB_ALLOWED_OWNERS=
REPO_POLL_S=120              # how often connected repositories are checked for new commits and pull requests
# Only with a GitHub App (GITHUB_APP_ID): 16+ random characters, e.g. `openssl rand -hex 32`. Without an app,
# POST /webhooks/github is turned off (404).
# GITHUB_WEBHOOK_SECRET=

# ---- who can join ----
# Unset: this server is one organisation. The first person to sign up creates it; everyone else joins by invitation.
# SIGNUP_ENABLED=true lets anyone who can sign in create another organisation (not with GITHUB_ALLOWED_OWNERS set).
# SIGNUP_ENABLED=

# ---- KT sessions (optional): Google Calendar + Meet, and Calendly. Without them, sessions are held anywhere and their
# recording is uploaded afterwards. docs/specs/scheduling.md ----
# Google Cloud console -> APIs & Services: enable the Google Calendar API and Google Drive API; Credentials -> OAuth client
# ID (Web application), authorized redirect URI: PUBLIC_URL/api/integrations/google/callback. Then Settings -> Integrations.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Calendly: create a webhook subscription (invitee.created, invitee.canceled) to PUBLIC_URL/webhooks/calendly and put its
# signing key here.
# CALENDLY_WEBHOOK_SIGNING_KEY=
# TOKEN_ENCRYPTION_KEY=      # encrypts stored Google refresh tokens; empty = generated into DATA_DIR (keep that folder)
# ---- Welcome Wave Voice (optional; disabled until all values and a public HTTPS tool URL are set) ----
# Agora Console -> project details: App ID and App Certificate; RESTful API: customer ID and secret.
# Murf dashboard -> API: an existing Falcon-capable API key. Keep every value private in selfhost.env.
# AGORA_APP_ID=
# AGORA_APP_CERTIFICATE=
# AGORA_CUSTOMER_ID=
# AGORA_CUSTOMER_SECRET=
# MURF_API_KEY=
# MURF_VOICE_ID=Matthew
# MURF_LOCALE=en-US
# VOICE_TOOL_URL=https://your-temporary-or-production-host.example
RECORDING_POLL_S=300         # how often ended Google sessions are checked for their Drive recording (0 = never)
# Raw video files are removed this many days after they were stored; notes and transcripts stay. 0 keeps every recording.
# Each removal is in the audit log (recording.retention_removed).
RECORDING_RETENTION_DAYS=0

# ---- email (optional): invitations, pre-boarding links (when a manager asks), the expert digest and the weekly summary ----
# Without these nothing is emailed: the web app shows each link for you to share. Port 587 uses STARTTLS, 465 SSL.
# Gmail: turn on 2-Step Verification, then Google Account -> Security -> App passwords -> create one; use it as the password
# (SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com). docs/INTEGRATIONS.md.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=                 # the From address; defaults to SMTP_USER

# ---- legal details (optional to start, needed before you sell): who operates this server ----
# The terms of service, the privacy policy and the data-processing agreement show these. Leave one empty and the documents
# say "the company that operates this service" instead: never a made-up name. `./scripts/selfhost.sh check` lists what is
# missing. Governing law and courts are your lawyer's call (docs/LEGAL.md). docs/specs/legal-consent.md.
# Put a value that has spaces in double quotes (this file is read by the shell): LEGAL_OPERATOR_NAME="..."
# LEGAL_OPERATOR_NAME=       # the company's registered legal name
# LEGAL_OPERATOR_ADDRESS=    # its registered address, on one line
# LEGAL_CONTACT_EMAIL=       # where legal notices and questions go
# LEGAL_PRIVACY_EMAIL=       # where privacy requests go (access, erasure, complaints)
# LEGAL_GOVERNING_LAW=       # as a phrase the terms can use: "the laws of ..."
# LEGAL_COURTS=              # as a phrase the terms can use: "the courts of ..."
# LEGAL_ENFORCE=false        # true: the API also refuses the workspace (403 legal_required) until a person has accepted the
#                            # current terms and privacy policy. Turn on only once the deployed web app shows the prompt.

# ---- where things live ----
PUBLIC_URL=http://localhost:5173  # with ENV=prod: the https:// address people open (plain http only for localhost)
DATA_DIR=.data               # uploaded documents and call recordings (relative to backend/)
# Behind your own reverse proxy (nginx, Caddy): how many proxies append to X-Forwarded-For, so each client is rate-limited
# on its own address. 0 = the address uvicorn resolved.
# RATE_LIMIT_TRUSTED_HOPS=0
