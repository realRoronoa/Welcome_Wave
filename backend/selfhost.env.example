# Welcome Wave, self-hosted (MODE=self_hosted): the real application on one machine.
# ./scripts/selfhost.sh setup  copies this to backend/selfhost.env with fresh database passwords. Never commit selfhost.env.
MODE=self_hosted
ENV=dev                      # prod on a server people use: refuses development settings such as the Firebase emulator

# ---- database: Postgres + pgvector in Docker (container ww-db, port 5433, volume ww-db-data) ----
DB_OWNER_PASSWORD=change-me  # the owner role: runs migrations only
APP_DB_PASSWORD=change-me    # the app role ww_app: no row-level-security bypass
DATABASE_URL=postgresql+psycopg://ww_app:change-me@127.0.0.1:5433/welcomewave

# ---- sign-in: Firebase Authentication (free; no billing needed) ----
# console.firebase.google.com -> Add project -> Build: Authentication -> Get started -> enable Email/Password and Google.
# Project settings -> General -> "Web API key" and "Project ID". Authentication -> Settings -> Authorized domains: add yours.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=        # defaults to <project id>.firebaseapp.com
# Development only, before the Firebase project exists: the local Firebase Auth emulator (npx firebase-tools emulators:start
# --only auth --project demo-welcome-wave). Accounts made there are for testing; the server refuses this with ENV=prod.
# FIREBASE_PROJECT_ID=demo-welcome-wave
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# ---- AI: a Gemini API key (https://aistudio.google.com/apikey). Empty = the AI is off, and the app says so. ----
GEMINI_API_KEY=
# The models your key can use: python -m scripts.check_models (in backend/) lists and tests them.
# MODEL_FAST=gemini-3.1-flash
# MODEL_SMART=gemini-3.1-pro
# MODEL_FALLBACK=gemini-3.1-flash

# ---- repositories: connected by their GitHub URL ----
GITHUB_TOKEN=                # optional, read-only fine-grained token: private repositories, 5,000 API calls/hour instead of 60
REPO_POLL_S=120              # how often connected repositories are checked for new commits and pull requests

# ---- KT sessions (optional): Google Calendar + Meet, and Calendly. Without them, sessions are held anywhere and their
# recording is uploaded afterwards. docs/specs/scheduling.md ----
# Google Cloud console -> APIs & Services: enable the Google Calendar API and Google Drive API; Credentials -> OAuth client
# ID (Web application), authorized redirect URI: PUBLIC_URL/api/integrations/google/callback. Then Settings -> Integrations.
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Calendly: create a webhook subscription (invitee.created, invitee.canceled) to PUBLIC_URL/webhooks/calendly and put its
# signing key here.
# CALENDLY_WEBHOOK_SIGNING_KEY=
# TOKEN_ENCRYPTION_KEY=      # encrypts stored Google refresh tokens; empty = generated into DATA_DIR (keep that folder)
RECORDING_POLL_S=300         # how often ended Google sessions are checked for their Drive recording (0 = never)

# ---- email (optional): invitations, pre-boarding links (when a manager asks), the expert digest and the weekly summary ----
# Without these nothing is emailed: the web app shows each link for you to share. Port 587 uses STARTTLS, 465 SSL.
# Gmail: turn on 2-Step Verification, then Google Account -> Security -> App passwords -> create one; use it as the password
# (SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com). docs/INTEGRATIONS.md.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=                 # the From address; defaults to SMTP_USER

# ---- where things live ----
PUBLIC_URL=http://localhost:5173
DATA_DIR=.data               # uploaded documents and call recordings (relative to backend/)
