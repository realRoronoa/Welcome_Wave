# ---- local demo: nothing needed ----
# Demo mode (MODE=demo, the default) reads nothing from this file, so it runs the same on every machine, with no keys:
# real credentials kept here for other modes never reach it. To use something in the demo on purpose, set it in the
# command's own environment, for example
#   GEMINI_API_KEY=... MODE=demo .venv/bin/uvicorn app.main:app --port 8080   real Gemini answers (AI Studio key)
#   DEMO_PASSWORD=...                                                          the demo sign-in password (default welcome-wave)
MODE=demo

# ---- production (MODE=gcp) ----
# In Cloud Run and GKE these are set by cloudbuild.yaml (configuration) and Secret Manager (secrets);
# this list is the reference for what exists. See docs/DEPLOY.md.
# ENV=dev                                   # prod refuses demo mode and development secrets
# DATABASE_URL=postgresql+psycopg://ww_app:PASSWORD@/welcomewave?host=/cloudsql/PROJECT:asia-south1:ww-db-dev   [secret]
# GCP_PROJECT=welcome-wave-dev
# GCP_REGION=asia-south1
# VERTEX_LOCATION=global
# EMBEDDING_LOCATION=                       # defaults to GCP_REGION
# GCS_BUCKET=welcome-wave-dev-ww-data
# MODEL_FAST=gemini-3.5-flash-lite   MODEL_SMART=gemini-3.5-flash   # Gemini API ids; on Vertex AI confirm them in Model Garden
# MODEL_FALLBACK=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash   # check all with: python -m scripts.check_models
# FIREBASE_API_KEY=                         # terraform output -raw firebase_api_key (public)
# PUBLIC_URL=https://app.example.com
# SIGNUP_ENABLED=                           # unset: MODE=gcp lets anyone create an organisation; false = invitation only
# CHAT_RATE_PER_MINUTE=12
# GITHUB_APP_ID=      GITHUB_APP_SLUG=      GITHUB_CLIENT_ID=
# GITHUB_PRIVATE_KEY=                       [secret]
# GITHUB_WEBHOOK_SECRET=                    [secret] 16+ random characters; required with a GitHub App (else webhooks are off)
# GITHUB_CLIENT_SECRET=                     [secret]
# KT sessions (docs/specs/scheduling.md): Google Calendar with Meet links, Calendly bookings, recordings from Drive
# GOOGLE_OAUTH_CLIENT_ID=                   # an OAuth client (Web application); empty = sessions are held elsewhere
# GOOGLE_OAUTH_CLIENT_SECRET=               [secret]
# GOOGLE_OAUTH_REDIRECT_URI=                # default: PUBLIC_URL + /api/integrations/google/callback
# CALENDLY_WEBHOOK_SIGNING_KEY=             [secret] the signing key of the Calendly webhook subscription
# TOKEN_ENCRYPTION_KEY=                     [secret, generated by Terraform] encrypts stored Google refresh tokens
# Email (optional; docs/INTEGRATIONS.md): invitations, pre-boarding links, the expert digest, the weekly summary. Empty = none are sent.
# SMTP_HOST=          SMTP_PORT=587          (587 = STARTTLS, 465 = SSL)
# SMTP_USER=          SMTP_FROM=             (From defaults to SMTP_USER)
# SMTP_PASSWORD=                            [secret]
# LangSmith tracing is off unless turned on explicitly: it sends agent prompts and outputs to LangSmith (docs/SECURITY.md)
# LANGSMITH_TRACING=false   LANGSMITH_PROJECT=welcome-wave-dev   LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=                        [secret]
# Legal details (docs/specs/legal-consent.md): who operates this service, as the terms, privacy policy and DPA name them.
# Not needed to start; an empty one shows as "the company that operates this service". Governing law and courts: ask your lawyer.
# LEGAL_OPERATOR_NAME=      LEGAL_OPERATOR_ADDRESS=
# LEGAL_CONTACT_EMAIL=      LEGAL_PRIVACY_EMAIL=
# LEGAL_GOVERNING_LAW=      LEGAL_COURTS=
# LEGAL_ENFORCE=false                       # true: 403 legal_required on workspace routes until the terms are accepted
