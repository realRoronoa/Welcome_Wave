# The application's non-secret settings, for every pod that runs the API image (backend/app/config.py explains each one).
# Secrets are never here: they come from the Secrets ww-api, ww-worker and ww-migrate (base/secrets.example.yaml).
# An overlay changes these in its settings/config.env. Comments must stay on their own lines (kustomize keeps the rest of
# a line as the value).

# ---- mode ----
# gcp: Cloud SQL, Vertex AI, Cloud Storage, Pub/Sub workers. components/self-hosted switches to self_hosted.
MODE=gcp
# prod refuses demo mode, the Firebase emulator, CORS_ORIGINS=* and a PUBLIC_URL that is not https.
ENV=prod

# ---- where people open the app ----
# Links in emails, OAuth redirects and the Ingress host name (components/public-url) all come from this.
PUBLIC_URL=https://app.example.com
# Empty: open sign-up in MODE=gcp. "false": invitation-only.
SIGNUP_ENABLED=

# ---- Google Cloud ----
GCP_PROJECT=
GCP_REGION=asia-south1
VERTEX_LOCATION=global
GCS_BUCKET=
PUBSUB_PREFIX=ww
# The scheduled calls (scheduler.yaml) carry a Google-signed token with this audience, for this service account; the API
# accepts no other caller of /internal/*. The audience is any fixed string: PUBLIC_URL is a good one.
OUTBOX_FLUSH_AUDIENCE=https://app.example.com
OUTBOX_FLUSH_INVOKER=

# ---- models (check them first: python -m scripts.check_models, docs/DEPLOY.md step 6) ----
MODEL_FAST=gemini-3.5-flash-lite
MODEL_SMART=gemini-3.5-flash
MODEL_FALLBACK=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash

# ---- sign-in (the Firebase web API key is public by design) ----
FIREBASE_API_KEY=

# ---- GitHub App (read-only scopes) ----
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=

# ---- Google Calendar + Meet for KT sessions; empty turns it off ----
GOOGLE_OAUTH_CLIENT_ID=

# ---- email (optional); the password is SMTP_PASSWORD in the Secret ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=

# ---- agent traces: off unless the organisation decides to send them to LangSmith (docs/SECURITY.md) ----
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=welcome-wave

# ---- traffic ----
# How many proxies in front of the API append to X-Forwarded-For (backend/app/ratelimit.py). 1: an in-cluster Ingress
# controller (the client's address is the last entry). Google's load balancer (GKE Ingress) appends two: set 2.
RATE_LIMIT_TRUSTED_HOPS=1
