# Staging: the settings that differ from infra/k8s/base/config.env. This is the file to edit for this environment.
# Comments must stay on their own lines (kustomize keeps the rest of a line as the value).
# Staging rehearses production, so it runs with ENV=prod and the same checks.

# The address people open. The Ingress host name, its certificate and OUTBOX_FLUSH_AUDIENCE follow it.
PUBLIC_URL=https://staging.app.example.com
OUTBOX_FLUSH_AUDIENCE=https://staging.app.example.com

# The Google Cloud project (Terraform's, in its dev or staging project)
GCP_PROJECT=welcome-wave-dev
GCP_REGION=asia-south1
GCS_BUCKET=welcome-wave-dev-ww-data
# <project>:<region>:<instance> (terraform output, or: gcloud sql instances describe ww-db-dev --format 'value(connectionName)')
CLOUD_SQL_INSTANCE=welcome-wave-dev:asia-south1:ww-db-dev
# The scheduler's Google service account. Its domain (after the @) also names every workload's Google service account
# (components/gke), so this one line ties the cluster's identities to the project.
OUTBOX_FLUSH_INVOKER=ww-scheduler@welcome-wave-dev.iam.gserviceaccount.com

# From `terraform output -raw firebase_api_key` (public by design)
FIREBASE_API_KEY=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=

LANGSMITH_PROJECT=welcome-wave-staging
# Google's load balancer appends "client, load balancer" to X-Forwarded-For
RATE_LIMIT_TRUSTED_HOPS=2
