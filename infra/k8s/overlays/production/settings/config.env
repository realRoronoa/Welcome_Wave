# Production: the settings that differ from infra/k8s/base/config.env. This is the file to edit for this environment.
# Comments must stay on their own lines (kustomize keeps the rest of a line as the value).

# The address people open. The Ingress host name, its certificate and OUTBOX_FLUSH_AUDIENCE follow it.
PUBLIC_URL=https://app.example.com
OUTBOX_FLUSH_AUDIENCE=https://app.example.com

# The Google Cloud project Terraform created for prod
GCP_PROJECT=welcome-wave-prod
GCP_REGION=asia-south1
GCS_BUCKET=welcome-wave-prod-ww-data
# <project>:<region>:<instance> (gcloud sql instances describe ww-db-prod --format 'value(connectionName)')
CLOUD_SQL_INSTANCE=welcome-wave-prod:asia-south1:ww-db-prod
# The scheduler's Google service account. Its domain (after the @) also names every workload's Google service account
# (components/gke), so this one line ties the cluster's identities to the project.
OUTBOX_FLUSH_INVOKER=ww-scheduler@welcome-wave-prod.iam.gserviceaccount.com

# From `terraform output -raw firebase_api_key` (public by design)
FIREBASE_API_KEY=
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=
# "false" for invitation-only
SIGNUP_ENABLED=

LANGSMITH_PROJECT=welcome-wave-prod
# Google's load balancer appends "client, load balancer" to X-Forwarded-For
RATE_LIMIT_TRUSTED_HOPS=2
