# Self-hosted on any cluster: the settings that differ from infra/k8s/base/config.env. This is the file to edit.
# Comments must stay on their own lines (kustomize keeps the rest of a line as the value). Secrets go in ww-api and
# ww-migrate (infra/k8s/base/secrets.example.yaml), never here.

# The https:// address people open; the Ingress host name and its certificate follow it.
PUBLIC_URL=https://onboarding.example.com

# Sign-in: a Firebase project (free). Project settings > General: the project ID and the web API key (public by design).
# Authentication > Settings > Authorized domains: add PUBLIC_URL's host.
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=

# Models for the Gemini API key in the ww-api Secret (python -m scripts.check_models lists what the key can use)
MODEL_FAST=gemini-3.5-flash-lite
MODEL_SMART=gemini-3.5-flash
MODEL_FALLBACK=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash

# Repositories are connected by URL and polled. Owners (comma-separated) whose PRIVATE repositories GITHUB_TOKEN may read.
GITHUB_ALLOWED_OWNERS=
REPO_POLL_S=120
# How often ended Google Calendar sessions are checked for their Drive recording (0 = never)
RECORDING_POLL_S=300
# Background jobs that run at once inside the API
LOCAL_WORKERS=3

# Who can join. Unset: one organisation (the first sign-up creates it; then by invitation). "true": anyone may create one.
SIGNUP_ENABLED=

# One Ingress controller in front appends the client's address to X-Forwarded-For
RATE_LIMIT_TRUSTED_HOPS=1

# Optional: email (password in the Secret as SMTP_PASSWORD), Google Calendar (secret as GOOGLE_OAUTH_CLIENT_SECRET)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_FROM=
GOOGLE_OAUTH_CLIENT_ID=
